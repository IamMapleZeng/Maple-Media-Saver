<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow" app:cardCornerRadius="24dp" app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/platform_youtube"
                android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" android:textStyle="bold" />
            <TextView android:id="@+id/badge_yt_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textAppearance="?attr/textAppearanceLabelMedium" />
        </LinearLayout>
        <TextView android:id="@+id/value_yt_version" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="12dp" android:textAppearance="?attr/textAppearanceBodySmall" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_yt_enabled"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/yt_enabled_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/yt_enabled_subtitle"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_youtube" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/yt_manage" />
        <TextView android:id="@+id/yt_diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/hook_diagnostics" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
